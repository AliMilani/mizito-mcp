# Copy to .env (chmod 600). tools/refresh-auth.sh writes MIZITO_TOKEN for you.
MIZITO_TOKEN=
# Optional
# MIZITO_WORKSPACE_ID=
# MIZITO_READ_ONLY=1        # register no write tools at all
# MIZITO_TIMEOUT=30
# MIZITO_CACHE_TTL=300      # seconds users/projects/labels stay cached
# MIZITO_LOG_LEVEL=WARNING  # INFO logs one line per API call (no bodies, no token)
